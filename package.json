{
  "name": "research-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "server": "tsx watch src/server.ts",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:build",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client:dev\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
